# Zugangsdaten der Supabase-Datenbank für die Seite "Aktuelles".
# Diese Datei ist nur ein Muster. Die echten Werte gehören in die Datei .env
# (gleicher Ordner). Beide Werte stehen in Supabase unter
# Project Settings > API Keys bzw. Data API ("Project URL" und "anon public").
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=hier-den-anon-public-schluessel-eintragen
